# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# live = call DeepSeek (responses cached on disk); cached = replay only, no network
LLM_PROVIDER=live
# local = sentence-transformers on CPU; cached = replay only
EMBED_PROVIDER=local
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# Auth (src/auth.py). Leave AUTH_DISABLED unset or 0; 1 is for local evaluation and CI only.
AUTH_DISABLED=0
OIDC_ISSUER=http://localhost:8080/realms/newcomer
OIDC_AUDIENCE=newcomer-api
# Optional: where the API fetches the JWKS if it differs from the issuer's host (e.g. inside Compose)
# OIDC_JWKS_URL=
# Allowed CORS origins, comma-separated; "*" is refused
WEB_ORIGINS=http://localhost:5173

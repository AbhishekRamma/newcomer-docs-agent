# ${API_ORIGIN} and ${OIDC_ORIGIN} are filled in by the image's envsubst step at start-up.
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${OIDC_ORIGIN}; frame-src 'self' ${OIDC_ORIGIN}; form-action 'self' ${OIDC_ORIGIN}; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${OIDC_ORIGIN}; frame-src 'self' ${OIDC_ORIGIN}; form-action 'self' ${OIDC_ORIGIN}; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri /index.html;
    }
}
